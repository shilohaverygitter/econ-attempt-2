  color: white;
  padding: 48px 20px 38px;
  text-align: center;
}

header h1 {
  font-size: 36px;
  margin: 0 0 8px;
}

header p {
  margin: 0;
  color: #dce8f7;
  font-size: 16px;
}

.container {
  max-width: 1050px;
  margin: 28px auto;
  padding: 0 18px 50px;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.tab {
  border: 1px solid var(--border);
  background: white;
  color: var(--navy);
  padding: 12px 18px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
}

.tab:hover {
  background: var(--light);
}

.tab.active {
  background: var(--navy);
  color: white;
  border-color: var(--navy);
}

.panel {
  display: none;
}

.panel.active {
  display: block;
}

.section-heading {
  margin: 0 0 6px;
  color: var(--navy);
  font-size: 27px;
}

.intro {
  color: var(--muted);
  margin-top: 0;
  margin-bottom: 22px;
}

.topic, .term-card, .question-card, .short-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 22px;
  margin-bottom: 16px;
  box-shadow: 0 2px 7px rgba(20, 40, 70, 0.04);
}

.topic h3, .short-card h3 {
  color: var(--blue);
  margin: 0 0 10px;
  font-size: 19px;
}

.topic p {
  margin: 8px 0;
}

.topic ul {
  padding-left: 22px;
  margin: 8px 0;
}

.key {
  color: var(--navy);
  font-weight: bold;
}

.example {
  background: var(--light);
  border-left: 4px solid var(--blue);
  padding: 12px 15px;
  border-radius: 5px;
  margin-top: 12px;
}

.term-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 12px;
}

.term-card {
  margin: 0;
  padding: 16px;
}

.term-card h3 {
  margin: 0 0 5px;
  color: var(--blue);
  font-size: 16px;
}

.term-card p {
  margin: 0;
  font-size: 14px;
}

.question-card {
  padding: 22px;
}

.question-number {
  color: var(--muted);
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 7px;
}

.question-text {
  font-weight: bold;
  margin-bottom: 14px;
}

.option {
  display: block;
  padding: 11px 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin: 8px 0;
  cursor: pointer;
  transition: background 0.15s;
}

.option:hover {
  background: var(--light);
}

.option input {
  margin-right: 9px;
}

.option.correct {
  border-color: var(--green);
  background: #e8f5ed;
}

.option.incorrect {
  border-color: var(--red);
  background: #fbecee;
}

.feedback {
  display: none;
  padding: 12px;
  border-radius: 8px;
  margin-top: 12px;
  font-size: 14px;
}

.feedback.show {
  display: block;
}

.feedback.right {
  background: #e8f5ed;
  color: #175d39;
}

.feedback.wrong {
  background: #fbecee;
  color: #922d35;
}

button.action {
  background: var(--blue);
  color: white;
  border: none;
  padding: 12px 19px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  margin: 8px 6px 8px 0;
}

button.action:hover {
  background: var(--navy);
}

button.secondary {
  background: #e6ebf2;
  color: var(--navy);
}

.score-box {
  background: var(--navy);
  color: white;
  padding: 20px;
  border-radius: 12px;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.score-box strong {
  font-size: 25px;
}

.progress-track {
  background: #dce3ed;
  height: 10px;
  border-radius: 20px;
  overflow: hidden;
  margin-top: 12px;
}

.progress-fill {
  background: #4c9b75;
  height: 100%;
  width: 0%;
  transition: width 0.2s;
}

.answer {
  display: none;
  background: var(--light);
  padding: 14px;
  border-radius: 8px;
  margin-top: 12px;
}

.answer.show {
  display: block;
}

footer {
  text-align: center;
  color: var(--muted);
  padding: 25px;
  font-size: 13px;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 28px;
  }

  .tab {
    flex: 1 1 40%;
  }

  .topic, .question-card, .short-card {
    padding: 17px;
  }
}
</style>
