let selectedAnswers = {};
let submitted = false;

function renderQuiz() {
  const container = document.getElementById("quizQuestions");

  container.innerHTML = quizData.map((item, index) => `
    <div class="question-card" id="question-${index}">
      <div class="question-number">QUESTION ${index + 1} OF ${quizData.length}</div>
      <div class="question-text">${item.q}</div>

      ${item.a.map((option, choice) => `
        <label class="option" id="option-${index}-${choice}">
          <input
            type="radio"
            name="question-${index}"
            value="${choice}"
            onchange="selectAnswer(${index}, ${choice})"
          >
          ${String.fromCharCode(65 + choice)}. ${option}
        </label>
      `).join("")}

      <div class="feedback" id="feedback-${index}"></div>
    </div>
  `).join("");

  updateScore();
}

function selectAnswer(question, choice) {
  if (submitted) return;

  selectedAnswers[question] = choice;
  updateScore();
}

function updateScore() {
  let answeredCount = Object.keys(selectedAnswers).length;
  let correctCount = 0;

  for (let index in selectedAnswers) {
    if (selectedAnswers[index] === quizData[index].c) {
      correctCount++;
    }
  }

  document.getElementById("score").textContent =
    correctCount + " / " + quizData.length;

  document.getElementById("answered").textContent =
    answeredCount + " / " + quizData.length;

  document.getElementById("progress").style.width =
    (answeredCount / quizData.length * 100) + "%";
}

function showResults() {
  if (submitted) return;

  submitted = true;
  let correctCount = 0;

  quizData.forEach((item, index) => {
    const feedback = document.getElementById("feedback-" + index);
    const selected = selectedAnswers[index];

    if (selected === item.c) {
      correctCount++;
      feedback.className = "feedback show right";
      feedback.innerHTML = "<strong>Correct!</strong> " + item.e;
    } else if (selected === undefined) {
      feedback.className = "feedback show wrong";
      feedback.innerHTML = "<strong>Not answered.</strong> Correct answer: " +
        String.fromCharCode(65 + item.c) + ". " + item.a[item.c] +
        "<br>" + item.e;
    } else {
      feedback.className = "feedback show wrong";
      feedback.innerHTML = "<strong>Incorrect.</strong> Correct answer: " +
        String.fromCharCode(65 + item.c) + ". " + item.a[item.c] +
        "<br>" + item.e;
    }

    item.a.forEach((option, choice) => {
      const label = document.getElementById(`option-${index}-${choice}`);

      if (choice === item.c) {
        label.classList.add("correct");
      } else if (choice === selected) {
        label.classList.add("incorrect");
      }
    });
  });

  const percentage = Math.round(correctCount / quizData.length * 100);

  let message = "";
  if (percentage >= 90) {
    message = "Excellent work! You have a strong understanding of these topics.";
  } else if (percentage >= 75) {
    message = "Good job! Review the questions you missed to strengthen your understanding.";
  } else if (percentage >= 60) {
    message = "You're getting there. Spend some more time reviewing the study guide.";
  } else {
    message = "Keep practising. Go back through the study guide and try again.";
  }

  document.getElementById("finalResult").innerHTML = `
    <div class="topic">
      <h3>Your Final Result: ${correctCount} / ${quizData.length} (${percentage}%)</h3>
      <p>${message}</p>
    </div>
  `;

  updateScore();
}

function resetQuiz() {
  selectedAnswers = {};
  submitted = false;
  document.getElementById("finalResult").innerHTML = "";
  renderQuiz();
}


