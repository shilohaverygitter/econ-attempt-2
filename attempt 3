<title>Economics Study Guide</title>

<style>
:root {
  --navy: #172b4d;
  --blue: #315b91;
  --light: #edf3fa;
  --background: #f5f7fb;
  --text: #263449;
  --muted: #66758a;
  --green: #24764b;
  --red: #b83c43;
  --border: #dce3ed;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

header {
